########################################################################
# cp .env.example .env, then fill in. .env is gitignored; this file is
# the documentation and must never contain a real value.
#
# Generate the two secrets with:
#   openssl rand -hex 32
########################################################################

# --- where n8n is reachable -------------------------------------------
# Host port the editor is published on. Change it if 5678 is taken.
N8N_HOST_PORT=5678
# The origin a browser, WooCommerce and your chat widget use. In production
# this is your HTTPS domain and it must end with a slash. Webhook URLs are
# built from it, so a wrong value means WooCommerce posts into the void.
N8N_PUBLIC_URL=http://localhost:5678/
# Number of reverse proxies in front of n8n. 0 for plain docker, 1 behind a
# single Caddy/nginx/Render proxy. Wrong values break rate limiting and the
# client IP in the logs.
N8N_PROXY_HOPS=0
N8N_LOG_LEVEL=info

# --- secrets ----------------------------------------------------------
# Encrypts every credential stored in the database. Lose it and the stored
# credentials are unrecoverable; change it and n8n will not start against an
# existing database. openssl rand -hex 32
N8N_ENCRYPTION_KEY=
# Shared secret the chat widget / email bridge sends as x-support-secret on
# every call to the support webhook. Compared in constant time in workflow 01.
SUPPORT_WEBHOOK_SECRET=
# The secret you set on the WooCommerce webhook (WooCommerce > Settings >
# Advanced > Webhooks). Workflow 02 recomputes the HMAC over the raw body.
WOO_WEBHOOK_SECRET=

# --- postgres ---------------------------------------------------------
POSTGRES_USER=n8n
POSTGRES_PASSWORD=
# n8n's own database.
POSTGRES_DB=n8n
# The application database created by db/init and populated from sql/schema.sql.
ECOM_OPS_DB=ecom_ops

# --- execution retention ----------------------------------------------
# Hours of execution history to keep (336 = 14 days) and a hard row cap.
# Whichever is hit first prunes.
EXECUTIONS_DATA_MAX_AGE=336
EXECUTIONS_DATA_PRUNE_MAX_COUNT=20000

# --- the store --------------------------------------------------------
STORE_NAME=Kettle and Fern
STORE_CURRENCY=GBP
GENERIC_TIMEZONE=Europe/London
# WooCommerce REST root, including the version. No trailing slash.
#   https://yourstore.com/wp-json/wc/v3
WOO_API_BASE=
# The consumer key / secret pair is NOT set here. It is stored as the n8n
# credential "WooCommerce REST API" (HTTP Basic Auth: key as user, secret as
# password), so it is encrypted at rest instead of sitting in a file.

# --- the model --------------------------------------------------------
# Any OpenAI-compatible chat completions endpoint. No trailing slash.
#   OpenAI        https://api.openai.com/v1
#   Azure OpenAI  https://<resource>.openai.azure.com/openai/deployments/<deployment>
#   Groq          https://api.groq.com/openai/v1
#   local vLLM    http://vllm:8000/v1
LLM_API_BASE=
LLM_MODEL=gpt-4o-mini
# The API key is NOT set here either - it is the n8n credential "LLM API Key"
# (HTTP Header Auth, name: Authorization, value: Bearer sk-...).

# --- support desk -----------------------------------------------------
# Where the agent posts its reply. Gorgias, Freshdesk, Help Scout, Zendesk or
# your own bridge - anything that accepts POST /conversations/{id}/reply.
SUPPORT_API_BASE=
# The gate in workflow 01. Below this, a human answers. Start at 0.8 for a new
# store and lower it once the decision log says the agent has earned it.
SUPPORT_CONFIDENCE_THRESHOLD=0.75

# --- email / marketing ------------------------------------------------
# Klaviyo, Brevo, Customer.io, Resend or your own sender.
EMAIL_API_BASE=
WELCOME_SEQUENCE_ID=welcome

# --- thresholds -------------------------------------------------------
# An order at or above this value alerts the sales channel, in store currency.
HIGH_VALUE_ORDER_THRESHOLD=150
# Lifetime spend at or above this marks a customer VIP.
VIP_LIFETIME_VALUE_THRESHOLD=500
# Abandoned-cart window. Younger than MIN is still live; older than MAX is cold.
ABANDONED_CART_MIN_AGE_HOURS=4
ABANDONED_CART_MAX_AGE_HOURS=48
# Stock at or below this opens a restock task.
LOW_STOCK_THRESHOLD=5

# --- slack ------------------------------------------------------------
# Incoming webhook URLs, one per channel. These are secrets: anyone holding one
# can post into that channel.
SLACK_HUMAN_REVIEW_WEBHOOK_URL=
SLACK_SALES_WEBHOOK_URL=
SLACK_SUPPLIER_WEBHOOK_URL=
SLACK_ALERTS_WEBHOOK_URL=
